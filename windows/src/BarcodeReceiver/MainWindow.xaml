<Window x:Class="BarcodeReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Shihab.Common.UI;assembly=Shihab.Common"
        Title="باركود · مستقبل الماسح" Width="940" Height="720" MinWidth="800" MinHeight="700"
        FlowDirection="RightToLeft" Background="{DynamicResource Bg}" FontFamily="{DynamicResource AppFont}"
        Foreground="{DynamicResource Text}" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="38" Height="38" Margin="0,0,12,0"
                       RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="باركود" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="باركود" Style="{StaticResource H1}" />
                    <TextBlock Text="مستقبل الماسح على الحاسوب" Style="{StaticResource MutedText}" />
                </StackPanel>
            </StackPanel>
            <Button x:Name="AboutButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                    Content="&#xE946;" ToolTip="حول" AutomationProperties.Name="حول" Click="OnAbout" />
        </Grid>

        <!-- One-line notice (identity renewed, ports busy, typing refused) -->
        <Border x:Name="NoticeBar" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource Control}"
                BorderBrush="{DynamicResource Warn}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                        Content="&#xE711;" ToolTip="إخفاء" AutomationProperties.Name="إخفاء التنبيه" Click="OnHideNotice" />
                <TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Pairing, then the connection type under it -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" FontSize="14"
                                        Content="&#xE72C;" ToolTip="رمز جديد: إلغاء اقتران كل الجوالات"
                                        AutomationProperties.Name="رمز اقتران جديد" Click="OnRenewKey" />
                                <TextBlock Text="اقتران جوال" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                            </DockPanel>
                            <!-- The code beside its caption, so the connection card under it fits without scrolling -->
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="White" CornerRadius="10" Padding="6"
                                        VerticalAlignment="Top">
                                    <Image x:Name="QrImage" Width="150" Height="150" RenderOptions.BitmapScalingMode="NearestNeighbor"
                                           AutomationProperties.Name="رمز الاقتران" />
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="امسحه بتطبيق باركود على الجوال" Style="{StaticResource MutedText}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PcName" FontWeight="Bold" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PcAddress" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                               TextAlignment="Right" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                                </StackPanel>
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <!-- Connection type -->
                    <Border Style="{StaticResource CardBorder}" Margin="0">
                        <StackPanel>
                            <TextBlock Text="الاتصال" Style="{StaticResource H2}" />

                            <Border Style="{StaticResource LinkRow}">
                                <DockPanel>
                                    <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="WifiState" DockPanel.Dock="Right" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                    <!-- Shown while no firewall rule lets the phones in (RCV-010) -->
                                    <Button x:Name="FirewallButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="34"
                                            Margin="0,0,8,0" Content="السماح" Visibility="Collapsed"
                                            ToolTip="السماح للجوالات بالوصول عبر جدار حماية ويندوز"
                                            AutomationProperties.Name="السماح للجوالات عبر جدار الحماية" Click="OnAllowFirewall" />
                                    <StackPanel>
                                        <TextBlock Text="الواي فاي" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock x:Name="WifiDetail" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource LinkRow}">
                                <DockPanel>
                                    <TextBlock Text="&#xE88E;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                    <TextBlock x:Name="CableState" DockPanel.Dock="Right" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Text="الكبل" FontWeight="Bold" FontSize="13.5" />
                                        <TextBlock x:Name="CableDetail" Style="{StaticResource MutedText}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource LinkRow}" Margin="0">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="&#xE702;" Style="{StaticResource Glyph}" Margin="0,0,10,0" />
                                        <TextBlock x:Name="BtState" DockPanel.Dock="Right" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Text="البلوتوث" FontWeight="Bold" FontSize="13.5" />
                                            <TextBlock x:Name="BtDetail" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Margin="32,8,0,0">
                                        <Button x:Name="BtButton" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Height="34"
                                                Padding="14,0" Margin="8,0,0,0" Click="OnBluetoothToggle" />
                                        <ComboBox x:Name="BtPhones" Height="34" DisplayMemberPath="Name"
                                                  AutomationProperties.Name="الجوال المقترن بالبلوتوث" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Recent scans, on the other side, full height -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32"
                                FontSize="14" Content="&#xEDE1;" IsEnabled="False" ToolTip="تصدير قراءات الجلسة: Excel أو CSV أو نص أو JSON"
                                AutomationProperties.Name="تصدير قراءات الجلسة" Click="OnExport" />
                        <TextBlock Text="آخر الرموز" Style="{StaticResource H2}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid>
                        <TextBlock x:Name="ScansEmpty" Text="لم يصل أي رمز بعد" Style="{StaticResource MutedText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <ListBox x:Name="Scans" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource ShihabListBoxItem}"
                                 AutomationProperties.Name="آخر الرموز">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel AutomationProperties.Name="{Binding Spoken}">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Glyph}" Foreground="{Binding GlyphBrush}"
                                                   Style="{StaticResource Glyph}" Margin="0,0,8,0" />
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Time}" FlowDirection="LeftToRight"
                                                   Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                       FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding From}" Style="{StaticResource MutedText}" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Footer: news line and the product signature -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <ui:AnnouncementBar x:Name="NewsBar" />
            <ui:BrandSignature x:Name="Signature" Inline="True" HorizontalAlignment="Center" Margin="0,6,0,0" />
        </StackPanel>
    </Grid>
</Window>
